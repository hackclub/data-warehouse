--- /dev/null
+++ b/orpheus_engine_dbt/tests/hackatime_category_hours_reconcile.sql
@@ -0,0 +1,12 @@
+SELECT 'daily_activity' AS model, hackatime_user_id
+FROM {{ ref('daily_activity') }}
+WHERE LEAST(hackatime_hours, tracked_coding_hours, ai_coding_hours, other_hours, total_hours) < 0
+   OR ABS(total_hours - tracked_coding_hours - ai_coding_hours - other_hours) > 0.02
+   OR (NOT legacy_coding_row_present AND hackatime_hours <> 0)
+UNION ALL
+SELECT 'hourly_project_activity' AS model, hackatime_user_id
+FROM {{ ref('hourly_project_activity') }}
+WHERE LEAST(hackatime_hours, tracked_coding_hours, ai_coding_hours, other_hours, total_hours) < 0
+   OR ABS(total_hours - tracked_coding_hours - ai_coding_hours - other_hours) > 0.02
+   OR (NOT legacy_coding_row_present AND hackatime_hours <> 0)
+   OR total_hours > 1
