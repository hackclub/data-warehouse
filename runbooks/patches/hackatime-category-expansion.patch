index 0000000..b19873c
--- /dev/null
+++ b/orpheus_engine_dbt/models/hackatime_analytics/schema.yml
@@ -0,0 +1,62 @@
+version: 2
+models:
+  - name: daily_activity
+    description: >-
+      Activity by user and New York day. Rows now include noncoding activity. To preserve the
+      old row set for counts, averages and membership, filter legacy_coding_row_present.
+      Daily includes zero-second heartbeat days; hourly includes positive unrounded
+      seconds from either timeline (even if rounded hours are zero).
+    columns:
+      - name: hackatime_hours
+        description: Exact legacy case-sensitive coding-only timeline, rounding and hourly ceiling. Not total tracked activity.
+        tests: [not_null]
+      - name: legacy_coding_row_present
+        description: True exactly when the original coding-only model emits this grain, including hours rounded to zero.
+        tests: [not_null]
+      - name: tracked_coding_hours
+        description: Coding component of the all-category timeline; can differ from hackatime_hours.
+        tests: [not_null]
+      - name: ai_coding_hours
+        description: All-category timeline gaps attributed to normalized category ai coding.
+        tests: [not_null]
+      - name: other_hours
+        description: All other categories including NULL, blank, unknown and timelapsing.
+        tests: [not_null]
+      - name: total_hours
+        description: >-
+          All-category capped time, not credited programming time. Each user gap is
+          capped at 120 seconds, attributed to the current heartbeat. Categories
+          normalize with LOWER(BTRIM(category)); equal timestamps order by heartbeat id.
+          Hourly components scale proportionally to a one-hour ceiling before rounding.
+          Total rounds once; sum of three rounded components may differ by at most 0.02 hours.
+        tests: [not_null]
+  - name: hourly_project_activity
+    description: >-
+      Activity by user, project and local hour. Rows now include noncoding activity. To preserve the
+      old row set for counts, averages and membership, filter legacy_coding_row_present.
+      Daily includes zero-second heartbeat days; hourly includes positive unrounded
+      seconds from either timeline (even if rounded hours are zero).
+    columns:
+      - name: hackatime_hours
+        description: Exact legacy case-sensitive coding-only timeline, rounding and hourly ceiling. Not total tracked activity.
+        tests: [not_null]
+      - name: legacy_coding_row_present
+        description: True exactly when the original coding-only model emits this grain, including hours rounded to zero.
+        tests: [not_null]
+      - name: tracked_coding_hours
+        description: Coding component of the all-category timeline; can differ from hackatime_hours.
+        tests: [not_null]
+      - name: ai_coding_hours
+        description: All-category timeline gaps attributed to normalized category ai coding.
+        tests: [not_null]
+      - name: other_hours
+        description: All other categories including NULL, blank, unknown and timelapsing.
+        tests: [not_null]
+      - name: total_hours
+        description: >-
+          All-category capped time, not credited programming time. Each user gap is
+          capped at 120 seconds, attributed to the current heartbeat. Categories
+          normalize with LOWER(BTRIM(category)); equal timestamps order by heartbeat id.
+          Hourly components scale proportionally to a one-hour ceiling before rounding.
+          Total rounds once; sum of three rounded components may differ by at most 0.02 hours.
+        tests: [not_null]
