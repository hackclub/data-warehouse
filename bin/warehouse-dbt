#!/usr/bin/env python3
"""Run dbt against the warehouse, by one of two routes.

    bin/warehouse-dbt compile -s my_model
        Runs here as the everyday WAREHOUSE_COOLIFY_URL login. compile, parse and ls
        only. That login cannot change existing data or tables, and dbt's on-run-end
        GRANT hooks make even `dbt test` fail under it. Compiled SQL lands in orpheus_engine_dbt/target/.

    bin/warehouse-dbt --elevated --reason "why" run -s my_model
    bin/warehouse-dbt --elevated --reason "why" test -s my_model
        Runs run, test or compile in the app container, as the login the syncs use,
        on this checkout's orpheus_engine_dbt/ tree. That is how a branch is built
        and tested before any merge. Uses SSH to the host; no password reaches this
        machine. Only with a written reason, and only for a runbook step that names
        it or a request that asks for the write: runbooks/prod-health-monitoring.md §10.

The temporary profile holds only references to environment variables.
"""

from __future__ import annotations

import argparse
import base64
import io
import json
import os
import subprocess
import sys
import tarfile
import tempfile
from pathlib import Path

BIN_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(BIN_DIR))

import _warehouse_dbt_container as container  # noqa: E402
from _warehouse_relay import (  # noqa: E402
    APP_CONTAINER_VAR,
    REPO_ROOT,
    Refused,
    clean_reason,
    fail,
    find_container,
    relay_argv,
    required_setting,
)

LOCAL_COMMANDS = {"compile", "parse", "ls", "list"}
ELEVATED_COMMANDS = {"run", "test", "compile"}
# The tool chooses these, so a stray flag cannot build tables in the wrong place.
PINNED_FLAGS = ("--project-dir", "--profiles-dir", "--profile", "--target", "-t")
EXCLUDED_FROM_UPLOAD = {"target", "logs"}


def _project_dir() -> Path:
    # WAREHOUSE_DBT_PROJECT_DIR is for the tool's own tests.
    return Path(os.environ.get("WAREHOUSE_DBT_PROJECT_DIR") or REPO_ROOT / "orpheus_engine_dbt")


def _refuse_pinned_flags(dbt_args: list[str]) -> None:
    for arg in dbt_args:
        if arg.split("=", 1)[0] in PINNED_FLAGS:
            raise Refused(f"{arg.split('=', 1)[0]} is set by this tool")


def _local_dbt() -> list[str]:
    dbt = REPO_ROOT / ".venv" / "bin" / "dbt"
    if dbt.exists():
        return [str(dbt)]
    return ["uv", "run", "--project", str(REPO_ROOT), "dbt"]


def run_local(command: str, dbt_args: list[str]) -> int:
    if command not in LOCAL_COMMANDS:
        raise Refused(
            f"`dbt {command}` can change existing tables or grants, which this login cannot do. "
            f'Use: bin/warehouse-dbt --elevated --reason "<why>" {command} ...'
        )
    url = required_setting("WAREHOUSE_COOLIFY_URL")
    salt = required_setting(container.SALT_VAR)
    with tempfile.TemporaryDirectory(prefix="warehouse-dbt-") as profiles_dir:
        container.write_profile(profiles_dir)
        return subprocess.run(
            [
                *_local_dbt(), command,
                "--project-dir", str(_project_dir()),
                "--profiles-dir", profiles_dir,
                *dbt_args,
            ],
            env=container.dbt_env(url, salt, "warehouse-dbt"),
            stdin=subprocess.DEVNULL,
        ).returncode


def _project_tar_b64(project_dir: Path) -> str:
    buffer = io.BytesIO()

    def keep(info: tarfile.TarInfo):
        top_level = Path(info.name).parts[:1]
        return None if top_level and top_level[0] in EXCLUDED_FROM_UPLOAD else info

    with tarfile.open(fileobj=buffer, mode="w:gz") as tar:
        tar.add(project_dir, arcname=".", filter=keep)
    return base64.b64encode(buffer.getvalue()).decode("ascii")


def _describe_checkout(project_dir: Path) -> str:
    def git(*args: str) -> subprocess.CompletedProcess:
        return subprocess.run(
            ["git", "-C", str(project_dir), *args], capture_output=True, text=True
        )

    commit = git("rev-parse", "--short", "HEAD")
    if commit.returncode != 0:
        return "not a git checkout"
    changed = git("status", "--porcelain", "--", ".").stdout.strip()
    return f"commit {commit.stdout.strip()}, {'uncommitted changes' if changed else 'clean'}"


def run_elevated(command: str, dbt_args: list[str], reason: str) -> int:
    if command not in ELEVATED_COMMANDS:
        raise Refused(
            f"--elevated runs only {', '.join(sorted(ELEVATED_COMMANDS))}, not `{command}`"
        )
    project_dir = _project_dir()
    if not (project_dir / "dbt_project.yml").is_file():
        raise Refused(f"no dbt project at {project_dir}")
    name = find_container(APP_CONTAINER_VAR)
    remote = relay_argv(["docker", "exec", "-i", name, f"{container.APP_ROOT}/.venv/bin/python", "-"])

    payload = json.dumps({"command": command, "args": dbt_args, "reason": reason})
    payload_b64 = base64.b64encode(payload.encode()).decode("ascii")
    source = (BIN_DIR / "_warehouse_dbt_container.py").read_text()
    program = (
        f"{source}\n\n"
        f"sys.exit(container_main({payload_b64!r}, {_project_tar_b64(project_dir)!r}))\n"
    )
    print(
        f"warehouse-dbt: elevated dbt {command} from {_describe_checkout(project_dir)}; "
        f"reason: {reason}",
        file=sys.stderr,
        flush=True,
    )
    return subprocess.run(remote, input=program, text=True).returncode


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Run dbt against the warehouse.",
        usage='warehouse-dbt [--elevated --reason "<why>"] <dbt command> [dbt args]',
    )
    parser.add_argument("--elevated", action="store_true")
    parser.add_argument("--reason")
    parser.add_argument("command")
    parser.add_argument("dbt_args", nargs=argparse.REMAINDER)
    args = parser.parse_args()

    try:
        _refuse_pinned_flags(args.dbt_args)
        if args.elevated:
            return run_elevated(args.command, args.dbt_args, clean_reason(args.reason))
        if args.reason:
            raise Refused("--reason only applies with --elevated")
        return run_local(args.command, args.dbt_args)
    except (Refused, ValueError, OSError) as error:
        return fail(str(error))


if __name__ == "__main__":
    sys.exit(main())
